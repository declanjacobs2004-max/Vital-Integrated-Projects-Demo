<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Vital Integrated Projects — Professional CCTV, Access Control, Fire Detection and Security Systems in Cape Town.">
<title>Vital Integrated Projects | Security Systems Cape Town</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #0c1a2e;
    --navy-mid: #163355;
    --blue: #2a6ecc;
    --bright-blue: #3a8be8;
    --white: #ffffff;
    --off-white: #f4f7fb;
    --light: #e8f0f8;
    --gray: #6b7c93;
    --mid-gray: #94a3b8;
    --border: #dde6ef;
    --text: #1a2940;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { font-family: 'DM Sans', sans-serif; background: var(--white); color: var(--text); overflow-x: hidden; }

  /* ── NAV ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
    background: rgba(255,255,255,0.97);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    height: 72px;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 5%;
    box-shadow: 0 2px 20px rgba(12,26,46,0.06);
  }
  .nav-logo img { height: 44px; width: auto; }
  .nav-center { display: flex; gap: 36px; list-style: none; }
  .nav-center a { font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: var(--gray); text-decoration: none; transition: color 0.2s; padding: 4px 0; border-bottom: 2px solid transparent; transition: all 0.2s; }
  .nav-center a:hover { color: var(--navy); border-bottom-color: var(--bright-blue); }
  .nav-right { display: flex; align-items: center; gap: 20px; }
  .nav-phone { font-family: 'Montserrat', sans-serif; font-size: 13px; font-weight: 700; color: var(--navy); display: flex; align-items: center; gap: 6px; text-decoration: none; }
  .nav-phone svg { width: 16px; height: 16px; stroke: var(--bright-blue); fill: none; stroke-width: 2; }
  .nav-quote { background: var(--bright-blue); color: white; padding: 9px 22px; font-family: 'Montserrat', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; text-decoration: none; border: none; cursor: pointer; transition: background 0.2s; clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 0 100%); display: inline-block; }
  .nav-quote:hover { background: var(--blue); }

  /* ── HERO ── */
  #hero {
    position: relative; min-height: 100vh;
    display: flex; align-items: center;
    padding: 120px 5% 80px;
    background: var(--white);
    overflow: hidden;
  }
  .hero-bg-shape {
    position: absolute; top: 0; right: 0; bottom: 0;
    width: 52%;
    background: linear-gradient(150deg, var(--off-white) 0%, var(--light) 100%);
    clip-path: polygon(8% 0, 100% 0, 100% 100%, 0 100%);
    z-index: 0;
  }
  .hero-bg-dots {
    position: absolute; top: 0; right: 0; bottom: 0; width: 52%;
    background-image: radial-gradient(circle, rgba(58,139,232,0.15) 1.5px, transparent 1.5px);
    background-size: 28px 28px;
    z-index: 1;
    clip-path: polygon(8% 0, 100% 0, 100% 100%, 0 100%);
  }
  .hero-accent-line {
    position: absolute; left: 5%; top: 50%; transform: translateY(-50%);
    width: 3px; height: 140px; background: linear-gradient(180deg, var(--bright-blue), transparent);
    z-index: 2;
  }
  .hero-content { position: relative; z-index: 3; max-width: 640px; padding-left: 28px; }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--light); border: 1px solid rgba(58,139,232,0.3);
    padding: 6px 16px; margin-bottom: 28px;
    font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--bright-blue);
    animation: fadeUp 0.7s ease both;
  }
  .hero-badge::before { content: ''; width: 6px; height: 6px; background: var(--bright-blue); border-radius: 50%; animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.4;transform:scale(0.7)} }
  .hero-title {
    font-family: 'Montserrat', sans-serif; font-size: clamp(40px, 5.5vw, 72px);
    font-weight: 900; line-height: 1.05; color: var(--navy);
    margin-bottom: 24px; letter-spacing: -1px;
    animation: fadeUp 0.7s 0.1s ease both;
  }
  .hero-title .accent { color: var(--bright-blue); }
  .hero-title .underline-accent { position: relative; display: inline-block; }
  .hero-title .underline-accent::after { content: ''; position: absolute; left: 0; bottom: -4px; width: 100%; height: 3px; background: var(--bright-blue); }
  .hero-sub {
    font-size: 17px; font-weight: 300; line-height: 1.75; color: var(--gray);
    max-width: 480px; margin-bottom: 40px;
    animation: fadeUp 0.7s 0.2s ease both;
  }
  .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; animation: fadeUp 0.7s 0.3s ease both; }
  .btn-primary { background: var(--bright-blue); color: white; padding: 15px 36px; font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; text-decoration: none; border: none; cursor: pointer; transition: all 0.2s; clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px)); display: inline-block; }
  .btn-primary:hover { background: var(--blue); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(58,139,232,0.3); }
  .btn-outline { background: transparent; color: var(--navy); padding: 14px 36px; font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; text-decoration: none; border: 2px solid var(--navy); cursor: pointer; transition: all 0.2s; display: inline-block; }
  .btn-outline:hover { background: var(--navy); color: white; }
  .hero-stats {
    position: absolute; bottom: 60px; left: 5%; padding-left: 28px;
    display: flex; gap: 48px; z-index: 3;
    animation: fadeUp 0.7s 0.4s ease both;
  }
  .stat-item { display: flex; flex-direction: column; }
  .stat-number { font-family: 'Montserrat', sans-serif; font-size: 32px; font-weight: 900; color: var(--navy); line-height: 1; }
  .stat-number span { color: var(--bright-blue); }
  .stat-label { font-size: 11px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; color: var(--mid-gray); margin-top: 4px; }
  .hero-visual {
    position: absolute; right: 5%; top: 50%; transform: translateY(-50%);
    z-index: 3; display: flex; flex-direction: column; gap: 16px;
    animation: fadeUp 0.7s 0.3s ease both;
  }
  .hero-service-pill {
    background: white; border: 1px solid var(--border);
    padding: 16px 24px; display: flex; align-items: center; gap: 14px;
    box-shadow: 0 4px 20px rgba(12,26,46,0.08);
    min-width: 240px; transition: transform 0.2s;
  }
  .hero-service-pill:hover { transform: translateX(-4px); }
  .pill-icon { width: 40px; height: 40px; background: var(--light); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .pill-icon svg { width: 20px; height: 20px; stroke: var(--bright-blue); fill: none; stroke-width: 1.8; }
  .pill-text { font-family: 'Montserrat', sans-serif; font-size: 13px; font-weight: 700; color: var(--navy); text-transform: uppercase; letter-spacing: 0.5px; }
  @keyframes fadeUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }

  /* ── SERVICE STRIP ── */
  .service-strip { background: var(--navy); padding: 0 5%; display: flex; }
  .strip-item { flex: 1; padding: 32px 24px; display: flex; flex-direction: column; align-items: center; gap: 12px; border-right: 1px solid rgba(255,255,255,0.08); cursor: default; transition: background 0.2s; }
  .strip-item:last-child { border-right: none; }
  .strip-item:hover { background: rgba(58,139,232,0.12); }
  .strip-icon { width: 52px; height: 52px; background: rgba(58,139,232,0.15); border: 1px solid rgba(58,139,232,0.3); display: flex; align-items: center; justify-content: center; }
  .strip-icon svg { width: 24px; height: 24px; stroke: var(--bright-blue); fill: none; stroke-width: 1.5; }
  .strip-label { font-family: 'Montserrat', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: white; text-align: center; }
  .strip-desc { font-size: 12px; color: rgba(255,255,255,0.45); text-align: center; line-height: 1.5; }

  /* ── SHARED ── */
  .section-label { font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 4px; text-transform: uppercase; color: var(--bright-blue); margin-bottom: 12px; display: flex; align-items: center; gap: 10px; }
  .section-label::before { content: ''; width: 28px; height: 2px; background: var(--bright-blue); }
  .section-title { font-family: 'Montserrat', sans-serif; font-size: clamp(28px, 4vw, 46px); font-weight: 900; color: var(--navy); line-height: 1.1; letter-spacing: -0.5px; margin-bottom: 16px; }
  .section-body { font-size: 15px; font-weight: 300; color: var(--gray); line-height: 1.8; max-width: 520px; }

  /* ── ABOUT BAND ── */
  #about { padding: 100px 5%; background: var(--off-white); }
  .about-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
  .about-features { display: flex; flex-direction: column; gap: 0; margin-top: 40px; }
  .about-feat { display: flex; gap: 20px; padding: 24px 0; border-bottom: 1px solid var(--border); align-items: flex-start; }
  .about-feat:last-child { border-bottom: none; }
  .feat-num { font-family: 'Montserrat', sans-serif; font-size: 11px; font-weight: 800; color: var(--bright-blue); letter-spacing: 1px; flex-shrink: 0; width: 28px; padding-top: 2px; }
  .feat-title { font-family: 'Montserrat', sans-serif; font-size: 14px; font-weight: 700; color: var(--navy); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.5px; }
  .feat-body { font-size: 13px; font-weight: 300; color: var(--gray); line-height: 1.65; }
  .about-visual { position: relative; }
  .about-box { background: white; border: 1px solid var(--border); padding: 48px; box-shadow: 0 8px 40px rgba(12,26,46,0.07); position: relative; }
  .about-box::before { content: ''; position: absolute; top: -8px; left: -8px; width: 100%; height: 100%; border: 2px solid var(--bright-blue); opacity: 0.2; z-index: -1; }
  .stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .stat-box { text-align: center; padding: 24px; background: var(--off-white); }
  .stat-box .big { font-family: 'Montserrat', sans-serif; font-size: 40px; font-weight: 900; color: var(--navy); line-height: 1; }
  .stat-box .big span { color: var(--bright-blue); }
  .stat-box .lbl { font-size: 11px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: var(--mid-gray); margin-top: 6px; }
  .psira-strip { display: flex; align-items: center; gap: 10px; background: var(--navy); padding: 14px 20px; margin-top: 24px; }
  .psira-strip span { font-family: 'Montserrat', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--bright-blue); }
  .psira-dot { width: 8px; height: 8px; background: var(--bright-blue); border-radius: 50%; animation: pulse 2s infinite; }

  /* ── SERVICES ── */
  #services { padding: 100px 5%; background: white; }
  .svc-header { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: end; margin-bottom: 64px; }
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); }
  .svc-card { background: white; padding: 44px 36px; position: relative; overflow: hidden; transition: all 0.3s; cursor: default; }
  .svc-card::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 3px; background: var(--bright-blue); transform: scaleX(0); transform-origin: left; transition: transform 0.3s; }
  .svc-card:hover::after { transform: scaleX(1); }
  .svc-card:hover { background: var(--off-white); box-shadow: 0 8px 32px rgba(12,26,46,0.07); z-index: 1; }
  .svc-icon { width: 56px; height: 56px; background: var(--light); border: 1px solid rgba(58,139,232,0.2); display: flex; align-items: center; justify-content: center; margin-bottom: 24px; transition: all 0.3s; }
  .svc-card:hover .svc-icon { background: var(--bright-blue); border-color: var(--bright-blue); }
  .svc-icon svg { width: 24px; height: 24px; stroke: var(--bright-blue); fill: none; stroke-width: 1.6; transition: stroke 0.3s; }
  .svc-card:hover .svc-icon svg { stroke: white; }
  .svc-title { font-family: 'Montserrat', sans-serif; font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--navy); margin-bottom: 12px; }
  .svc-desc { font-size: 13px; font-weight: 300; color: var(--gray); line-height: 1.7; }
  .svc-num { position: absolute; bottom: 20px; right: 24px; font-family: 'Montserrat', sans-serif; font-size: 72px; font-weight: 900; color: rgba(12,26,46,0.03); line-height: 1; pointer-events: none; }

  /* ── PORTFOLIO ── */
  #portfolio { padding: 100px 5%; background: var(--off-white); }
  .port-header { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: end; margin-bottom: 64px; }
  .port-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .port-card { background: white; border: 1px solid var(--border); overflow: hidden; transition: all 0.3s; cursor: default; box-shadow: 0 2px 12px rgba(12,26,46,0.04); }
  .port-card:hover { box-shadow: 0 12px 40px rgba(12,26,46,0.12); transform: translateY(-4px); border-color: rgba(58,139,232,0.3); }
  .port-card-top { background: var(--navy); padding: 32px; position: relative; overflow: hidden; min-height: 140px; display: flex; align-items: flex-end; }
  .port-card-top::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(58,139,232,0.15) 0%, transparent 60%); }
  .port-card-num { position: absolute; top: 16px; right: 20px; font-family: 'Montserrat', sans-serif; font-size: 60px; font-weight: 900; color: rgba(255,255,255,0.05); line-height: 1; }
  .port-sector-tag { background: rgba(58,139,232,0.2); border: 1px solid rgba(58,139,232,0.4); padding: 4px 12px; font-family: 'Montserrat', sans-serif; font-size: 9px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--bright-blue); position: relative; z-index: 1; }
  .port-card-body { padding: 24px 28px; }
  .port-title { font-family: 'Montserrat', sans-serif; font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: var(--navy); margin-bottom: 10px; }
  .port-desc { font-size: 13px; font-weight: 300; color: var(--gray); line-height: 1.65; }

  /* ── PARTNERS ── */
  #partners { padding: 80px 5%; background: white; overflow: hidden; }
  .partners-head { text-align: center; margin-bottom: 52px; }
  .partners-head .section-label { justify-content: center; }
  .partners-head .section-label::before { display: none; }
  .partners-wrap { position: relative; overflow: hidden; }
  .partners-wrap::before, .partners-wrap::after { content: ''; position: absolute; top: 0; bottom: 0; width: 80px; z-index: 2; }
  .partners-wrap::before { left: 0; background: linear-gradient(90deg, white, transparent); }
  .partners-wrap::after { right: 0; background: linear-gradient(-90deg, white, transparent); }
  .partners-track { display: flex; animation: scrollPartners 24s linear infinite; width: max-content; }
  .partners-track:hover { animation-play-state: paused; }
  @keyframes scrollPartners { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }
  .partner-tile { width: 220px; height: 110px; border: 1px solid var(--border); margin: 0 10px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; padding: 16px; flex-shrink: 0; transition: all 0.3s; cursor: default; background: white; }
  .partner-tile:hover { border-color: var(--bright-blue); box-shadow: 0 4px 20px rgba(58,139,232,0.1); }
  .partner-name { font-family: 'Montserrat', sans-serif; font-size: 16px; font-weight: 800; letter-spacing: 1px; color: var(--navy); transition: color 0.3s; }
  .partner-tile:hover .partner-name { color: var(--bright-blue); }
  .partner-cat { font-family: 'Montserrat', sans-serif; font-size: 9px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: var(--mid-gray); }
  .partner-bar { width: 24px; height: 2px; background: var(--bright-blue); margin-top: 4px; transform: scaleX(0); transform-origin: left; transition: transform 0.3s; }
  .partner-tile:hover .partner-bar { transform: scaleX(1); }

  /* ── SECTORS ── */
  #sectors { padding: 100px 5%; background: var(--off-white); }
  .sectors-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-top: 48px; }
  .sector-chip { background: white; border: 1px solid var(--border); padding: 20px 22px; display: flex; align-items: center; gap: 12px; transition: all 0.2s; cursor: default; }
  .sector-chip:hover { border-color: var(--bright-blue); box-shadow: 0 4px 16px rgba(58,139,232,0.1); }
  .sector-chip:hover .chip-dot { transform: scale(1.5); }
  .chip-dot { width: 8px; height: 8px; background: var(--bright-blue); flex-shrink: 0; transition: transform 0.2s; }
  .chip-label { font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--navy); }

  /* ── CONTACT ── */
  #contact { padding: 100px 5%; background: white; }
  .contact-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
  .contact-details { display: flex; flex-direction: column; gap: 28px; margin-top: 40px; }
  .cdet { display: flex; gap: 16px; align-items: flex-start; }
  .cdet-icon { width: 44px; height: 44px; background: var(--light); border: 1px solid rgba(58,139,232,0.2); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .cdet-icon svg { width: 18px; height: 18px; stroke: var(--bright-blue); fill: none; stroke-width: 1.8; }
  .cdet-label { font-family: 'Montserrat', sans-serif; font-size: 9px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--bright-blue); margin-bottom: 4px; }
  .cdet-val { font-size: 15px; font-weight: 500; color: var(--navy); }
  .contact-form { display: flex; flex-direction: column; gap: 14px; background: var(--off-white); padding: 40px; border: 1px solid var(--border); }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group label { font-family: 'Montserrat', sans-serif; font-size: 9px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--gray); }
  .form-group input, .form-group select, .form-group textarea { background: white; border: 1px solid var(--border); color: var(--navy); padding: 12px 16px; font-family: 'DM Sans', sans-serif; font-size: 14px; outline: none; transition: border-color 0.2s; width: 100%; }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--bright-blue); box-shadow: 0 0 0 3px rgba(58,139,232,0.08); }
  .form-group select option { background: white; }
  .form-group textarea { resize: vertical; min-height: 100px; }
  .form-title { font-family: 'Montserrat', sans-serif; font-size: 16px; font-weight: 800; color: var(--navy); letter-spacing: -0.3px; margin-bottom: 8px; }
  .form-subtitle { font-size: 13px; color: var(--gray); margin-bottom: 16px; }

  /* ── FOOTER ── */
  footer { background: var(--navy); padding: 48px 5%; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px; }
  .footer-logo img { height: 38px; width: auto; filter: brightness(0) invert(1); }
  .footer-copy { font-size: 12px; color: rgba(255,255,255,0.4); }
  .footer-links { display: flex; gap: 24px; }
  .footer-links a { font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,0.5); text-decoration: none; transition: color 0.2s; }
  .footer-links a:hover { color: var(--bright-blue); }
  .footer-psira { display: flex; align-items: center; gap: 8px; }
  .footer-psira span { font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--bright-blue); }

  /* MOBILE */
  @media (max-width: 900px) {
    .nav-center, .nav-phone { display: none; }
    #hero { flex-direction: column; padding: 100px 4% 60px; }
    .hero-bg-shape, .hero-bg-dots, .hero-visual { display: none; }
    .hero-stats { position: relative; bottom: auto; left: auto; padding-left: 0; margin-top: 40px; flex-wrap: wrap; }
    .about-inner, .svc-header, .port-header, .contact-inner { grid-template-columns: 1fr; gap: 40px; }
    .svc-grid, .port-grid { grid-template-columns: 1fr; }
    footer { flex-direction: column; align-items: flex-start; }
    .service-strip { flex-wrap: wrap; }
    .strip-item { flex: 0 0 50%; }
  }
</style>
</head>
